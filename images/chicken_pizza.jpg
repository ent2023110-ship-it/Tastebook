<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
  <defs>
    <linearGradient id="pizzaGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D84315"/>
      <stop offset="100%" stop-color="#FF7043"/>
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#pizzaGrad)"/>
  <circle cx="400" cy="220" r="140" fill="#FFE082" stroke="#BF360C" stroke-width="12"/>
  <circle cx="400" cy="220" r="120" fill="#FFCA28"/>
  <!-- Pepperoni / toppings -->
  <circle cx="360" cy="180" r="22" fill="#C62828"/>
  <circle cx="440" cy="190" r="20" fill="#C62828"/>
  <circle cx="390" cy="250" r="24" fill="#C62828"/>
  <circle cx="440" cy="260" r="18" fill="#C62828"/>
  <circle cx="340" cy="240" r="16" fill="#2E7D32"/>
  <circle cx="420" cy="150" r="15" fill="#2E7D32"/>
  <text x="400" y="410" font-family="'Outfit', Arial, sans-serif" font-size="34" font-weight="bold" fill="#ffffff" text-anchor="middle">Classic Chicken BBQ Pizza</text>
  <text x="400" y="445" font-family="'Outfit', Arial, sans-serif" font-size="18" fill="#ffffff" opacity="0.9" text-anchor="middle">TasteBook Gourmet Selection</text>
</svg>
