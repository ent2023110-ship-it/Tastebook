<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
  <defs>
    <linearGradient id="pancakeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E65100"/>
      <stop offset="100%" stop-color="#FFD54F"/>
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#pancakeGrad)"/>
  <!-- Plate -->
  <ellipse cx="400" cy="270" rx="190" ry="45" fill="#FFFFFF" opacity="0.9"/>
  <!-- Pancake Stack -->
  <ellipse cx="400" cy="250" rx="140" ry="30" fill="#FFB74D"/>
  <ellipse cx="400" cy="225" rx="135" ry="28" fill="#FFA726"/>
  <ellipse cx="400" cy="200" rx="130" ry="26" fill="#FFB74D"/>
  <!-- Butter pad -->
  <rect x="375" y="170" width="50" height="25" rx="4" fill="#FFEE58"/>
  <text x="400" y="410" font-family="'Outfit', Arial, sans-serif" font-size="34" font-weight="bold" fill="#ffffff" text-anchor="middle">Fluffy Golden Buttermilk Pancakes</text>
  <text x="400" y="445" font-family="'Outfit', Arial, sans-serif" font-size="18" fill="#ffffff" opacity="0.9" text-anchor="middle">Morning Breakfast Classic</text>
</svg>
