<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
  <defs>
    <linearGradient id="riceGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#BF360C"/>
      <stop offset="100%" stop-color="#FF8F00"/>
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#riceGrad)"/>
  <!-- Bowl -->
  <path d="M260,200 Q400,340 540,200 Z" fill="#ECEFF1"/>
  <!-- Rice mound -->
  <ellipse cx="400" cy="190" rx="140" ry="40" fill="#FFF9C4"/>
  <circle cx="370" cy="180" r="10" fill="#E65100"/>
  <circle cx="430" cy="185" r="8" fill="#2E7D32"/>
  <circle cx="400" cy="175" r="9" fill="#FFD54F"/>
  <text x="400" y="410" font-family="'Outfit', Arial, sans-serif" font-size="34" font-weight="bold" fill="#ffffff" text-anchor="middle">Sri Lankan Vegetable &amp; Egg Fried Rice</text>
  <text x="400" y="445" font-family="'Outfit', Arial, sans-serif" font-size="18" fill="#ffffff" opacity="0.9" text-anchor="middle">Wok Tossed Aromatic Special</text>
</svg>
